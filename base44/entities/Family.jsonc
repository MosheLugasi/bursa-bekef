// משפחה = חשבון. הרשמה פתוחה: כל משתמש מחובר יכול לפתוח משפחה שהוא חבר בה (היוצר הוא הבעלים).
// רק מנהל המשחק (role: admin) קובע מכסת שחקנים, משבית משפחות או ממנה בעלים נוספים.
// members – כתובות Gmail (באותיות קטנות) שמותר להן להיכנס; owners – בעלים נוספים שהמנהל מינה.
{
  "name": "Family",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "max_profiles": {
      "type": "number",
      "default": 4,
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "active": {
      "type": "boolean",
      "default": true,
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "owners": {
      "type": "array",
      "items": { "type": "string" },
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "members": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["name"],
  "rls": {
    "read": { "$or": [{ "data.members": "{{user.email}}" }, { "created_by_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "create": { "$or": [{ "user_condition": { "role": "admin" } }, { "data.members": { "$in": ["{{user.email}}"] } }] },
    "update": { "$or": [{ "created_by_id": "{{user.id}}" }, { "data.owners": { "$in": ["{{user.email}}"] } }, { "user_condition": { "role": "admin" } }] },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
