// בקשת גישה: מי שהתחבר עם Google ועוד לא שייך למשפחה. רק המנהל רואה את כל הבקשות.
{
  "name": "AccessRequest",
  "type": "object",
  "properties": {
    "email": { "type": "string" },
    "name": { "type": "string" }
  },
  "required": ["email"],
  "rls": {
    "read": { "$or": [{ "created_by_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "create": { "data.email": "{{user.email}}" },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "$or": [{ "created_by_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] }
  }
}
